{
  "components": {
    "schemas": {
      "AddSSHKeyRequestBody": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "description": "The private SSH key (may be passphrase-encrypted)",
            "maxLength": 16384,
            "type": "string"
          },
          "name": {
            "description": "The name of the SSH key",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_ .@-]+$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "key"
        ],
        "type": "object"
      },
      "CreateGroupRequestBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "The name of the group",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_ .@-]+$",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "GroupListResponseBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The list of groups",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "total": {
            "description": "The total number of groups",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "GroupSearchData": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "Item": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "resources_attached": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "resources_attached"
        ],
        "type": "object"
      },
      "LoginRequestBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "The password for login",
            "maxLength": 128,
            "minLength": 16,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "SSHKeySearchData": {
        "additionalProperties": false,
        "properties": {
          "encrypted": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "encrypted"
        ],
        "type": "object"
      },
      "SearchRequestBody": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "The search query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "SearchResponseGroupSearchDataBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The search results",
            "items": {
              "$ref": "#/components/schemas/GroupSearchData"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "total": {
            "description": "The total number of search results",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "SearchResponseSSHKeySearchDataBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The search results",
            "items": {
              "$ref": "#/components/schemas/SSHKeySearchData"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "total": {
            "description": "The total number of search results",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sever Gram Api",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/account/login": {
      "post": {
        "operationId": "post-login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Post login"
      }
    },
